# ==============================================================================
# Variables de Entorno de Ejemplo - Plataforma de Telemetría SimRacing (ApexLink)
# Configuración del Servidor Central PostgreSQL y Herramientas Auxiliares
# ==============================================================================

# Configuración del Motor PostgreSQL
POSTGRES_DB=apexlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Configuración de pgAdmin 4 (Opcional - perfil: tools)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@apexlink.local
PGADMIN_DEFAULT_PASSWORD=admin
